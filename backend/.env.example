# =============================================================================
# SAKA DELIVERY KDS - CONFIGURAÇÃO DE AMBIENTE
# =============================================================================
# Este arquivo contém todas as variáveis de ambiente necessárias para o projeto.
# Copie este arquivo para .env e preencha com seus valores reais.
#
# ═══════════════════════════════════════════════════════════════════════════
# LEGENDA DE SEGURANÇA:
# 🔴 CRÍTICO - Deve ser mantido em segredo absoluto
# 🟡 IMPORTANTE - Não commitar em repositórios públicos
# 🟢 SEGURO - Pode ser compartilhado (exceto valores reais)
# =============================================================================


# =============================================================================
# 🔴 SEÇÃO 1: BANCO DE DADOS
# =============================================================================
# Configuração da conexão com o banco de dados PostgreSQL.
# O formato async é usado pela aplicação, e o sync para migrations Alembic.
#
# Para desenvolvimento local (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./saka_kds.db
#
# Para produção (PostgreSQL) - SUBSTITUA os valores:
# DATABASE_URL=postgresql+asyncpg://USUARIO:SENHA@HOST:5432/NOME_BANCO
DATABASE_URL=sqlite+aiosqlite:///./saka_delivery.db


# =============================================================================
# 🔴 SEÇÃO 2: AUTENTICAÇÃO E JWT
# =============================================================================
# Chaves secretas para geração de tokens JWT.
# ⚠️ IMPORTANTE: Em produção, use uma chave forte e única!
# Gere com: openssl rand -hex 64
#
# Valor atual (DESENVOLVIMENTO APENAS - MUDAR EM PRODUÇÃO!):
JWT_SECRET=saka-delivery-secret-key-change-in-production-12345678

# Tempo de expiração dos tokens JWT em minutos
# Padrão: 1440 minutos (24 horas)
JWT_EXPIRE_MINUTES=1440

# Algoritmo de criptografia do JWT (não alterar)
JWT_ALGORITHM=HS256


# =============================================================================
# 🟡 SEÇÃO 3: iFOOD API (integração de delivery)
# =============================================================================
# Credenciais para integração com o webhook do iFood.
# Obtidas no painel do desenvolvedor iFood.
#
# Status: ATIVO - Usado em app/routers/webhook.py
#
# CLIENT_ID (público):
IFOOD_CLIENT_ID=

# CLIENT_SECRET (🔴 CRÍTICO - mantener segredo):
IFOOD_CLIENT_SECRET=


# =============================================================================
# 🟡 SEÇÃO 4: MERCADO PAGO (pagamentos)
# =============================================================================
# Configurações para processamento de pagamentos via Mercado Pago.
# Usado em: webhook_pagamento.py, faturamento.py
#
# Status: ATIVO - Em uso no projeto
#
# --------------------------------------------------------------------
# Chave Pública (usada no frontend)
#_PREFIXO: TEST_ para sandbox, PROD_ para produção
# 🟢 Pode ser exposta no frontend
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------------
# Access Token (🔴 CRÍTICO - acesso à API)
#_PREFIXO: TEST_ para sandbox, PROD_ para produção
# ⚠️ NUNCA exponha em código client-side!
MERCADOPAGO_ACCESS_TOKEN=

# --------------------------------------------------------------------
# Segredo do Webhook (🔴 CRÍTICO)
# Usado para validar autenticidade das notificações.
# Gere com: openssl rand -hex 32
# ⚠️ Mantenha este valor em absolute segredo!
MERCADOPAGO_WEBHOOK_SECRET=

# --------------------------------------------------------------------
# Configurações de Retry do Webhook
# Número de tentativas e intervalo em segundos
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5


# =============================================================================
# 🟢 SEÇÃO 5: GOOGLE GEMINI AI (inteligência artificial)
# =============================================================================
# API Key para uso de recursos de IA (Gemini).
# Obtida em: https://aistudio.google.com/app/apikey
#
# Status: DEFINIDO MAS NÃO VERIFICADO USO ATUAL
# Procure por "gemini" no código para confirmar utilização.
GEMINI_API_KEY=


# =============================================================================
# 🟢 SEÇÃO 6: CONFIGURAÇÕES DO SERVIDOR
# =============================================================================
# Configurações de rede e comportamento do servidor.

# Endereço IP onde o servidor will listen
# Padrão: 0.0.0.0 (todas as interfaces)
HOST=0.0.0.0

# Porta do servidor HTTP
# Padrão: 8000
PORT=8000

# Modo de debug
# ⚠️ SEMPRE defina como "false" em produção!
# Valores: true, false
DEBUG=true

# URL do frontend para CORS
# Usado para permitir requisições cross-origin
FRONTEND_URL=http://localhost:5173


# =============================================================================
# 🟢 SEÇÃO 7: VARIÁVEIS DE AMBIENTE (não alterar)
# =============================================================================
# Estas variáveis são usadas internamente pelo Python/FastAPI
# Não requerem alteração na maioria dos casos.

# Ambiente de execução (development, production)
# PYTHON_ENV=development

# Caminho do arquivo de ambiente (não alterar)
# ENV_FILE=.env


# =============================================================================
# 📋 RESUMO DE AUDITORIA DE APIs
# =============================================================================
# | API/Serviço      | Status    | Arquivos que usam                    |
# |------------------|-----------|--------------------------------------|
# | PostgreSQL/SQLite| ATIVO     | database.py, config.py              |
# | iFood            | ATIVO     | app/routers/webhook.py              |
# | MercadoPago      | ATIVO     | webhook_pagamento.py, faturamento.py|
# | Gemini AI        | DEFINIDO  | config.py (uso não confirmado)      |
# | JWT              | ATIVO     | auth.py, security.py               |
#
# =============================================================================
# ⚠️ RECOMENDAÇÕES DE SEGURANÇA PARA PRODUÇÃO
# =============================================================================
#
# 1. ARMAZENAMENTO DE SEGREDOS:
#    - Use gerenciadores de segredos em produção (AWS Secrets Manager,
#      Azure Key Vault, HashiCorp Vault, ou Doppler)
#    - Nunca commit arquivos .env com valores reais
#    - Adicione .env ao .gitignore
#
# 2. ROTAÇÃO DE CREDENCIAIS:
#    - Rotate JWT_SECRET a cada 90 dias
#    - Rotate MercadoPago tokens mensalmente
#    - Rotate iFood secrets trimestralmente
#
# 3. SEPARAÇÃO DE AMBIENTES:
#    - Use arquivos .env distintos para cada ambiente
#    - .env.development, .env.staging, .env.production
#    - Configure CI/CD para injetar secrets em tempo de deploy
#
# 4. PRINCÍPIO DE MENOR PRIVILÉGIO:
#    - Tokens de produção devem ter permissões mínimas necessárias
#    - Use tokens de teste/sandbox para desenvolvimento
#    - Revogue tokens não utilizados
#
# 5. MONITORAMENTO:
#    - Configure alertas para tentativas de acesso indevido
#    - Logue tentativas de autenticação falhas
#    - Use ferramentas de SIEM se disponível
#
# =============================================================================
