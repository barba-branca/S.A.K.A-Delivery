# iFood API Credentials
IFOOD_CLIENT_ID=your_ifood_client_id
IFOOD_CLIENT_SECRET=your_ifood_client_secret

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saka_delivery

# CORS - Frontend URL
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-key
JWT_EXPIRE_MINUTES=1440

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
